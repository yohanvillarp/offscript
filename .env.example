# Optional live inference: choose a model supported by installed Mozaik.
OFFSCRIPT_MODEL=

# Supply only the credentials for your selected provider; never commit .env.
# OPENAI_API_KEY=replace-with-your-key
# ANTHROPIC_API_KEY=replace-with-your-key
# GEMINI_API_KEY=replace-with-your-key

# The local integration entry point explicitly disables Mozaik Cloud export.
MOZAIK_API_KEY=

# Local host development: export these in the shell before npm run dev:server.
# The server script does not automatically load .env.
# OFFSCRIPT_PROJECT_ROOT=/absolute/path/to/the/project
# OFFSCRIPT_DATA_DIRECTORY=.offscript
# OFFSCRIPT_PORT=4317
# Without OFFSCRIPT_PORT, the operating system chooses an available port.
