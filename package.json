{
  "name": "offscript",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:packages && npm --prefix apps/studio run lint",
    "build": "npm --prefix apps/studio run build",
    "check": "npm run typecheck:domain && npm run typecheck:contracts && npm run typecheck:application && npm run typecheck:browser && npm run typecheck:orchestration && npm run typecheck:persistence && npm run typecheck:runtime && npm run typecheck:server && npm run typecheck:projects && npm run db:check && npm --prefix apps/studio run typecheck:tests && npm test && npm run lint && npm run build",
    "commitlint": "commitlint",
    "typecheck:domain": "tsc -p packages/domain/tsconfig.json && tsc -p packages/domain/tests/tsconfig.json",
    "test:domain": "node --test packages/domain/tests/*.test.ts",
    "test": "npm run test:domain && npm run test:contracts && npm run test:application && npm run test:browser && npm run test:orchestration && npm run test:persistence && npm run test:runtime && npm run test:server && npm run test:projects && npm --prefix apps/studio test",
    "typecheck:browser": "tsc -p packages/browser/tsconfig.json && tsc -p packages/browser/tests/tsconfig.json",
    "test:browser": "node --test packages/browser/tests/*.test.ts",
    "typecheck:application": "tsc -p packages/application/tsconfig.json && tsc -p packages/application/tests/tsconfig.json",
    "test:application": "node --test packages/application/tests/*.test.ts",
    "typecheck:contracts": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/contracts/tests/tsconfig.json",
    "test:contracts": "node --test packages/contracts/tests/*.test.ts",
    "typecheck:orchestration": "tsc -p packages/orchestration/tsconfig.json && tsc -p packages/orchestration/tests/tsconfig.json",
    "test:orchestration": "node --import ./packages/orchestration/tests/setup.ts --test packages/orchestration/tests/*.test.ts",
    "demo:mozaik": "node scripts/mozaik/run.ts",
    "typecheck:persistence": "tsc -p packages/persistence/tsconfig.json && tsc -p packages/persistence/tests/tsconfig.json",
    "test:persistence": "node --test packages/persistence/tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "lint:packages": "npm exec --prefix apps/studio --offline -- oxlint packages scripts drizzle.config.ts offscript.mjs",
    "typecheck:runtime": "tsc -p packages/runtime/tsconfig.json && tsc -p packages/runtime/tests/tsconfig.json",
    "test:runtime": "node --test packages/runtime/tests/*.test.ts",
    "typecheck:server": "tsc -p packages/server/tsconfig.json && tsc -p packages/server/tests/tsconfig.json",
    "test:server": "node --test packages/server/tests/*.test.ts",
    "dev:server": "node scripts/server/run.ts",
    "typecheck:projects": "tsc -p packages/projects/tsconfig.json && tsc -p packages/projects/tests/tsconfig.json",
    "test:projects": "node --test packages/projects/tests/*.test.ts",
    "build:local": "npm run build && tsc -p tsconfig.distribution.json && node scripts/server/distribution-assets.ts",
    "start": "node offscript.mjs",
    "prepack": "npm run build:local"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "husky": "^9.1.7",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@mozaik-ai/core": "4.2.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "version": "0.0.0",
  "bin": {
    "offscript": "offscript.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "offscript.mjs",
    "dist"
  ]
}
